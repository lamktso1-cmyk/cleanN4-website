# ==============================================================================
# CLEANNOVA ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# Cổng hoạt động của máy chủ CleanNova
PORT=3000
NODE_ENV=development

# Khóa bí mật JWT (Dùng để ký và giải mã phiên làm việc của người dùng)
JWT_SECRET=cleannova_super_secure_jwt_secret_2026_n4_gold

# Facebook App OAuth Configuration (Khi triển khai môi trường Production thực tế)
# Đăng ký tại https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cấu hình Supabase (Nếu sử dụng Supabase làm BaaS thay thế backend Node.js)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
